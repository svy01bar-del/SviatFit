+.action-icon,.action-add{border:1px solid #303b4e;background:#18202c;color:#eef3fb;font-size:21px}
+.action-next{border:0;background:var(--accent);color:#071020;font-size:16px}
+.action-next span{font-size:20px;margin-left:4px}
+.workout-actionbar button:disabled{opacity:.35}
+.timer{
+ left:10px;right:10px;bottom:calc(76px + env(safe-area-inset-bottom));
+ border-radius:16px;padding:10px 12px;
+ background:rgba(18,27,40,.98);border-color:#345175;
+ box-shadow:0 14px 42px rgba(0,0,0,.48)
+}
+.timer .time{font-size:25px}
+.timer .btn{min-height:40px}
+
