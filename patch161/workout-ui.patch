+.exercise-item.done{opacity:1;background:#101c18;border-color:#244438}
+.exercise-summary{min-height:58px;grid-template-columns:32px minmax(0,1fr) auto;padding:10px 12px;gap:9px}
+.exercise-symbol{width:30px;height:30px;display:grid;place-items:center;border-radius:50%;font-size:16px;background:#202838;border:1px solid #334056}
