+.exercise-meta{font-size:12px}
+.exercise-arrow{color:#7f8a9c}
+.exercise-expanded{padding:0 12px 12px;border-top-color:#2a3548}
+.exercise-tools{justify-content:flex-start;padding-top:10px}
+.exercise-tools .btn{min-height:40px;padding:8px 11px;font-size:12px;border-radius:12px}
+.exercise-expanded .sethead{margin-top:4px}
+.exercise-expanded .sethead,.exercise-expanded .setrow{grid-template-columns:30px minmax(0,1fr) minmax(0,1fr) 48px 44px;gap:6px}
+.exercise-expanded .sethead{font-size:11px}
+.exercise-expanded .setrow{padding:4px 0}
+.exercise-expanded .stepper{grid-template-columns:38px minmax(0,1fr) 38px;border-radius:13px}
+.exercise-expanded .stepper button{height:46px;font-size:20px}
+.exercise-expanded .stepper input{font-size:16px;font-weight:800}
+.exercise-expanded .check{width:44px;height:44px;border-radius:13px}
+.exercise-expanded .setRir{min-height:44px;padding:0 4px;border-radius:12px;text-align:center}
+.exercise-expanded .reco{border-radius:14px;padding:11px}
+.exercise-expanded .reco strong{font-size:15px}
+
+.feedback-details{margin-top:12px;border-top:1px solid var(--line);padding-top:8px}
+.feedback-details summary{min-height:44px;display:flex;align-items:center;justify-content:space-between;gap:8px;cursor:pointer;list-style:none;font-weight:800;font-size:13px}
+.feedback-details summary::-webkit-details-marker{display:none}
+.feedback-state{font-size:11px;color:var(--muted);font-weight:600}
+.feedback-card{padding:8px 0 0!important}
+.feedback-card .switch{border-bottom:0}
+.feedback-card textarea{min-height:64px}
+
+.workout-actionbar{
+ position:fixed;left:0;right:0;bottom:0;z-index:80;
