--- a/app/src/main/assets/index.html
+++ b/app/src/main/assets/index.html
@@
 .workout-overview{
  position:sticky;top:0;z-index:18;
- margin:0 -12px 8px;padding:12px 14px 10px;
+ margin:0 -12px 8px;padding:calc(34px + env(safe-area-inset-top)) 14px 10px;
  border:0;border-bottom:1px solid #202a38;border-radius:0;
  background:rgba(12,15,20,.96);backdrop-filter:blur(16px);
 }
@@
 .workout-actionbar{
  position:fixed;left:0;right:0;bottom:0;z-index:80;
  display:grid;grid-template-columns:52px 52px minmax(0,1fr);gap:8px;
- max-width:720px;margin:auto;padding:8px 12px calc(8px + env(safe-area-inset-bottom));
+ max-width:720px;margin:auto;padding:8px 12px calc(20px + env(safe-area-inset-bottom));
  background:rgba(12,15,20,.96);backdrop-filter:blur(16px);
  border-top:1px solid #283244;
 }
@@
 .timer{
- left:10px;right:10px;bottom:calc(76px + env(safe-area-inset-bottom));
+ left:10px;right:10px;bottom:calc(88px + env(safe-area-inset-bottom));
  border-radius:16px;padding:10px 12px;
  background:rgba(18,27,40,.98);border-color:#345175;
  box-shadow:0 14px 42px rgba(0,0,0,.48)
 }